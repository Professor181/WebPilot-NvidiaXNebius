# WebPilot backend configuration. Copy to `.env` — every value is optional.

# Network
WEBPILOT_HOST=127.0.0.1
WEBPILOT_PORT=8000
# Public base URL (set to your HTTPS tunnel URL when exposing /mcp to Alexa+)
WEBPILOT_BASE_URL=http://localhost:8000
# Next.js Alexa+ web client (Part 2)
WEBPILOT_FRONTEND_URL=http://localhost:3000
# Extra browser origins allowed to call /mcp and /api (comma separated)
WEBPILOT_ALLOWED_ORIGINS=

# Approval gate — CHANGE THIS SECRET for any shared deployment
WEBPILOT_APPROVAL_SECRET=webpilot-alexa-plus-2026-hmac-secret-key
WEBPILOT_APPROVAL_TTL_SECONDS=900

# Tier 1 adapters (optional: raises the GitHub API limit from 60 to 5000 requests/hour)
GITHUB_TOKEN=

# ---- AI brain (backend/llm_brain.py) — all optional; the symbolic engine always works.
# auto | bedrock | ollama | cloud | deterministic
WEBPILOT_BRAIN_PROVIDER=auto

# AWS Bedrock Converse API (enabled by AWS credentials or WEBPILOT_USE_BEDROCK=true).
# Your account needs model access to BEDROCK_MODEL_ID; some regions require an inference profile id (e.g. "us.<model-id>").
WEBPILOT_USE_BEDROCK=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Local Ollama (auto-probed; OLLAMA_MODEL defaults to the first of llama3.2 / qwen2.5 / mistral installed)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=

# Cloud LLM REST API: vendor auto-detected from the key (sk-ant- → Anthropic, AIza → Gemini, otherwise OpenAI)
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
WEBPILOT_LLM_TIMEOUT_SECONDS=45

# Browser runtime
WEBPILOT_ENABLE_PLAYWRIGHT=true
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_LAUNCH_TIMEOUT_SECONDS=20
WEBPILOT_HTTP_TIMEOUT_SECONDS=15

# Storage (defaults: backend/webpilot.db and backend/artifacts)
# WEBPILOT_DB_PATH=
# WEBPILOT_ARTIFACTS_DIR=

# Universal Live Web Autopilot
WEBPILOT_AUTOPILOT_SEARCH_URL=https://html.duckduckgo.com/html/
WEBPILOT_AUTOPILOT_MAX_STEPS=6
WEBPILOT_AUTOPILOT_SLOW_MO_MS=400
WEBPILOT_AUTOPILOT_LOGIN_WAIT_SECONDS=120
# WEBPILOT_BROWSER_PROFILE_DIR=backend/browser_profile
# Persistent Profile mode attaches to your running Chrome here first (loopback only; see start_chrome_debug.bat)
WEBPILOT_CHROME_CDP_URL=http://localhost:9222
WEBPILOT_CHROME_CDP_TIMEOUT_MS=15000
# Extra brand → start URL entries for the live autopilot (JSON), e.g. {"myshop": "https://shop.example"}
WEBPILOT_SITE_DIRECTORY_JSON=

# The WebPilot Chrome: a real Chrome with its own long-lived profile (your sign-ins), auto-started on demand
WEBPILOT_CHROME_AUTOLAUNCH=true
# WEBPILOT_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
# WEBPILOT_CHROME_PROFILE_DIR=%LOCALAPPDATA%\WebPilot\ChromeProfile
# Conversations keep their tab; idle ones close (and their screenshots are deleted) after this many seconds
WEBPILOT_CONVERSATION_IDLE_SECONDS=1800
# Screenshots of finished stand-alone tasks are deleted after this many seconds
WEBPILOT_SCREENSHOT_RETENTION_SECONDS=1800
# How long a task waits for your sign-in choice / for you to finish a step in the browser window
WEBPILOT_LOGIN_CHOICE_TIMEOUT_SECONDS=600
WEBPILOT_AUTOPILOT_LOGIN_WAIT_SECONDS=300
# Only used to create accounts you approve (can also be set in the UI: Settings & logins)
WEBPILOT_USER_EMAIL=
WEBPILOT_USER_FULL_NAME=
